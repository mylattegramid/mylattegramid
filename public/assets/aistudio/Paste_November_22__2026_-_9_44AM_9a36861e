  <script>
    // Mobile Menu Toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
    });

    // Interactive Product Gallery Switcher
    function switchProductImage(src, altText, captionTitle, captionDesc, btnElement) {
      const mainImg = document.getElementById('main-product-img');
      const titleEl = document.getElementById('gallery-caption-title');
      const descEl = document.getElementById('gallery-caption-desc');
      const fallbackEl = document.getElementById('fallback-produk');

      mainImg.classList.remove('hidden');
      fallbackEl.classList.add('hidden');
      document.getElementById('missing-filename').textContent = src;

      mainImg.style.opacity = '0.35';
      setTimeout(() => {
        mainImg.src = src;
        mainImg.alt = altText;
        titleEl.textContent = captionTitle;
        descEl.textContent = captionDesc;
        mainImg.style.opacity = '1';
      }, 140);

      document.querySelectorAll('.gallery-thumb').forEach(thumb => {
        thumb.classList.remove('ring-2', 'ring-caramel-500', 'opacity-100');
        thumb.classList.add('opacity-65');
      });
      btnElement.classList.add('ring-2', 'ring-caramel-500', 'opacity-100');
      btnElement.classList.remove('opacity-65');
    }

    // Order Quantity & WhatsApp Integration
    const quantities = { '250ml': 1, '1L': 1 };
    const prices = { '250ml': 22000, '1L': 78000 };

    function updateQty(variant, change) {
      quantities[variant] = Math.max(1, quantities[variant] + change);
      document.getElementById(`qty-${variant}`).textContent = quantities[variant];
    }

    function orderWhatsApp(variant) {
      // GANTI nomor WhatsApp di bawah ini dengan nomor bisnis Anda (format 628xxx)
      const phoneNumber = '6281234567890'; 
      const qty = quantities[variant];
      const total = (qty * prices[variant]).toLocaleString('id-ID');
      const productName = variant === '250ml' 
        ? 'Kopi Susu Bapak (Kemasan 250 ml)' 
        : 'Kopi Susu Bapak (Kemasan 1 Liter)';

      const message = `Halo Mylattegram! Saya ingin memesan:\n\n` +
                      `• Produk: *${productName}*\n` +
                      `• Jumlah: *${qty} botol*\n` +
                      `• Estimasi Total: *Rp ${total}*\n\n` +
                      `Mohon info ketersediaan dan pengirimannya. Terima kasih!`;

      const url = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    }
  </script>
